{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "REACT_APP_ICA_ENABLED": "false",
    "REACT_APP_YL_ENABLED": "false",
    "REACT_APP_YC_ENABLED": "false",
    "REACT_APP_MYSCORE_ENABLED": "false"
  }
}

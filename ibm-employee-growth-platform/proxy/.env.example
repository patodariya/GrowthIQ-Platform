# ICA proxy configuration — copy this file to ".env" and fill in real values.
# ".env" is gitignored; NEVER commit a real key.

# API key from ICA Settings -> API Keys -> ICA APIs. Server-side only.
ICA_API_KEY=YOUR_ICA_API_KEY_HERE

# ICA REST base URL (default is the beta gateway from ICA-NOTES.md).
ICA_BASE_URL=https://api.nextgen-beta.ica.ibm.com/ica/v1

# Namespace the id below lives in: "assistants" or "agents".
# You are creating an agent, so this will most likely be "agents".
ICA_NAMESPACE=agents

# The assistant/agent id you pass as `model`.
# Find it with:  curl "http://localhost:3001/api/list?ns=agents"
ICA_MODEL_ID=REPLACE_WITH_YOUR_AGENT_ID

# YourCareer@IBM API configuration
# Base URL for YourCareer API
YC_BASE_URL=https://api.yourlearning.ibm.com

# Bearer token from YourCareer@IBM (get from browser dev tools)
# This token is personal and should be kept secure
YC_TOKEN=REPLACE_WITH_YOUR_YOURCAREER_TOKEN

# Your IBM employee ID (e.g., 0026EM744)
YC_EMPLOYEE_ID=REPLACE_WITH_YOUR_EMPLOYEE_ID

# ── BIW / ThanksBIW (Recognition Received + Points Deposited) ──────────────
# Personal JWT from https://thanksibm.recognition-now.io (expires in ~1 h).
# How to get it:
#   1. Open recognition-now.io in your browser and sign in.
#   2. Open DevTools → Network tab → filter for "activity-feed".
#   3. Copy the Authorization header value (everything after "Bearer ").
#   4. Paste it below (without the "Bearer " prefix).
BIW_TOKEN=REPLACE_WITH_YOUR_BIW_TOKEN

# Port this proxy listens on. The React app points REACT_APP_ICA_PROXY_URL here.
PORT=3001

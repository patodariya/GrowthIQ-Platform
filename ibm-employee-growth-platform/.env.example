# Copy to ".env" to turn on the ICA-powered AI cards. Restart `npm start` after
# changing these (Create React App only reads env vars at startup).

# Turn ICA integration on. When unset/false, the AI Monthly Summary and AI
# Career Nudge use their built-in copy and the app makes NO network calls.
REACT_APP_ICA_ENABLED=true

# Turn YourCareer@IBM integration on. When unset/false, the Skills Development
# tab uses fallback data and the app makes NO YourCareer API calls.
REACT_APP_YC_ENABLED=true

# Where the proxy (proxy/server.js) is listening. Defaults to this when unset.
REACT_APP_ICA_PROXY_URL=http://localhost:3001
